# Dùng khi build (npm run build) — Cloudflare Pages đọc file này, không cần đặt biến trên dashboard.
# Địa chỉ trang (canonical, sitemap, ảnh chia sẻ Facebook)
VITE_SITE_URL=https://ose.vn
# API của ose.vn (backend trên home server, qua Cloudflare Tunnel). Cũng là nguồn nội dung khi build.
VITE_API_BASE=https://api-osevn.ose.vn
# ose.vn không dùng Render: khi backend tắt, trang tĩnh trên Pages vẫn hiện đủ phần mềm và bài viết.
VITE_API_FALLBACK=
